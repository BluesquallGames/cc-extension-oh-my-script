{
  "name": "oh-my-script",
  "extensionName": "oh-my-script",
  "version": "0.0.1-alpha.1",
  "type": "module",
  "package_version": 2,
  "editor": ">=3.8.6",
  "author": "Bluesquall Team",
  "files": [
    "dist/**/*",
    "mount/**/*"
  ],
  "main": "dist/main.cjs",
  "creator": {
    "hookScript": "dist/hooks.cjs"
  },
  "scripts": {
    "prepublishOnly": "vite build --mode=production",
    "build": "pnpm --filter=* run build && vite build --mode=development",
    "dev": "vite build --mode=development --watch",
    "deploy": "npm run pack:build-core && pnpm --node-linker=hoisted --filter=\"oh-my-script\" deploy --legacy --prod .deploy && cd .deploy && bestzip ../oh-my-script.zip *",
    "pack:build-core": "cd packages/build-core && npm run prepublishOnly"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.5",
    "@shrinktofit/eslint-plugin": "^0.0.9",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^5.2.1",
    "bestzip": "^2.2.1",
    "eslint": "^9.33.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@oms/build-core": "workspace:*",
    "fs-extra": "^11.3.0",
    "primevue": "^4.3.1",
    "vue": "^3.5.13",
    "winston": "^3.17.0",
    "winston-transport": "*",
    "yaml": "^2.7.0"
  }
}
