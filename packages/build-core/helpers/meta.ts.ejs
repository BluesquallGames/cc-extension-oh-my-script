export default {
  entries: [
<% entries.forEach(entry => { -%>
    ['<%= entry.bundleId %>', <%= entry.isEditorEntry %>],
<% }); %>
  ],
  exports: {
<% Object.entries(exportEntries).forEach(([exportId, entryId]) => { -%>
    <%- JSON.stringify(exportId) %>: <%- JSON.stringify(entryId) %>,
<% }); -%>
  },
};
