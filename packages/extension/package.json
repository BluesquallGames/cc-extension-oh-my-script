{
  "name": "oh-my-script",
  "private": true,
  "version": "0.0.1-alpha.5",
  "package_version": 2,
  "editor": ">=3.8.5",
  "author": "Bluesquall Team",
  "vortex": {
    "extensionName": "oh-my-script"
  },
  "type": "module",
  "main": "./dist/main.cjs",
  "files": [
    "dist",
    "!dist/**/*.map",
    "mount",
    "types"
  ],
  "creator": {
    "hookScript": "./dist/hooks.cjs"
  },
  "contributions": {
    "profile": {
      "project": {
        "builder.useElectronRunAsNode": {
          "type": "boolean",
          "default": true,
          "label": "Use Electron RunAsNode",
          "description": "Use the current Cocos Creator or Vortex executable as the OMS builder's Node.js runtime when supported. Takes effect the next time the OMS builder starts."
        }
      }
    },
    "project": {
      "ohMyScript": {
        "label": "Oh My Script",
        "content": {
          "builder.useElectronRunAsNode": {
            "ui": "ui-checkbox",
            "tooltip": "Use the current Cocos Creator or Vortex executable as the OMS builder's Node.js runtime when supported. Takes effect the next time the OMS builder starts."
          }
        }
      }
    }
  },
  "scripts": {
    "prepublishOnly": "vite build --mode=production",
    "build": "vue-tsc -b --noEmit && vite build --mode=development",
    "pack:build-core": "cd packages/build-core && npm run prepublishOnly",
    "test": "vitest run"
  },
  "exm": {
    "registry": "http://exm.bluesquall.local/",
    "registryPackageName": "@cyclonium/extension-oh-my-script"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "catalog:",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "bestzip": "^2.2.1",
    "less": "^4.6.4",
    "memfs": "^4.57.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.2.8"
  },
  "dependencies": {
    "@cyclonium/cc-extension-utils": "^0.0.102",
    "@oms/build-core": "workspace:*",
    "@oms/systemjs": "workspace:*",
    "@oms/task-queue": "workspace:*",
    "dayjs": "^1.11.20",
    "fs-extra": "^11.3.0",
    "semver": "^7.8.5",
    "vue": "^3.5.13",
    "winston": "^3.17.0",
    "winston-transport": "*",
    "yaml": "^2.7.0"
  }
}
