{
  "include": ["src"],
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "verbatimModuleSyntax": true,
    "strict": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "types": [
      "node",
    ],
  },
}