{
  "include": ["src"],
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "esnext.disposable"],
    "module": "node16",
    "moduleResolution": "node16",
    "verbatimModuleSyntax": true,
    "strict": true,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "composite": true,
    "types": []
  }
}
