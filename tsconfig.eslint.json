{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "eslint.config.mjs",
    "docs/.vitepress/**/*.mts",
    "packages/*/vite.config.ts",
    "packages/*/vitest.config.ts",
    "packages/extension/src/**/*.vue",
    "packages/extension/types/**/*.d.ts",
    "tests/plugin/check-*.js"
  ]
}
